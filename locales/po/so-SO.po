msgstr "Been"

#: gpstemplates.php
msgid "Device Template"
msgstr "Qaabka Aaladda"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Dooro Qaab-dhismeedka Qalabka si loogu saleeyo noocan Qaab-dhismeedka Khariidadda."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Dooro Sawirka la Muujinayo ee Qalab Shaqaynaya"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Dooro Sawirka la Muujinayo ee Qalab Soo Kabanaya"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Dooro Sawirka la Muujinayo ee Qalab aan Shaqaynayn"

#: gpstemplates.php
msgid "Access Point"
msgstr "Barta Helitaanka"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Qaab-dhismeedkan Qalabku ma wuxuu matalaa Access Point."

#: gpstemplates.php
msgid "No"
msgstr "Maya"

#: gpstemplates.php
msgid "Yes"
msgstr "Haa"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "Wax ka beddelka Qaab-dhismeedka Khariidadda"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
