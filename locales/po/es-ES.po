#: gpstemplates.php
msgid "Device Template"
msgstr "Plantilla de Dispositivo"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Elija la plantilla de dispositivo en la que basar este tipo de plantilla de mapa."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Seleccione la imagen a mostrar para un dispositivo activo"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Seleccione la imagen a mostrar para un dispositivo en recuperación"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Seleccione la imagen a mostrar para un dispositivo inactivo"

#: gpstemplates.php
msgid "Access Point"
msgstr "Punto de acceso"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "¿Esta plantilla de dispositivo representa un punto de acceso?."

#: gpstemplates.php
msgid "No"
msgstr "No"

#: gpstemplates.php
