msgstr "Asegúrese de configurar correctamente Mapas primero en Configuración > Mapas"

#: gpstemplates.php
msgid "Delete"
msgstr "Eliminar"

#: gpstemplates.php
msgid "Map Templates"
msgstr "Plantillas de mapas"

#: gpstemplates.php
