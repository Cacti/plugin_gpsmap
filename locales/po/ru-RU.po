#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "Пожалуйста, сначала убедитесь, что правильно настроили Карты в Настройки > Карты"

#: gpstemplates.php
msgid "Delete"
msgstr "Удалить"

#: gpstemplates.php includes/setup/settings.php
msgid "Map Templates"
msgstr "Шаблоны карт"

#: gpstemplates.php
msgid "Host Template"
msgstr "Шаблон хоста"

#: gpstemplates.php
msgid "Up Image"
msgstr "Поднять изображение вверх"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "Восстановление изображения"

#: gpstemplates.php
msgid "Down Image"
msgstr "Опустить изображение вниз"

#: gpstemplates.php
msgid "Is AP"
msgstr "Это точка доступа"

#: gpstemplates.php
msgid "True"
msgstr "Истина"

