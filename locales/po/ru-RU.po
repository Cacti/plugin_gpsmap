msgstr "Ложь"

#: gpstemplates.php
msgid "Device Template"
msgstr "Шаблон Устройства"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Выберите шаблон устройства для создания этого типа шаблона карты."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Выберите изображение для отображения работающего устройства"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Выберите изображение для отображения восстанавливающегося устройства"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Выберите изображение для отображения упавшего устройства"

#: gpstemplates.php
msgid "Access Point"
msgstr "Точка доступа"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Представляет ли этот шаблон устройства точку доступа."

#: gpstemplates.php
msgid "No"
msgstr "Нет"

#: gpstemplates.php
msgid "Yes"
msgstr "Да"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "Редактировать шаблон карты"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "Начать заново"

#: includes/polling/processregion.php
msgid "Print"
msgstr "Печать"

#: includes/setup/settings.php includes/setup/tabs.php
msgid "Maps"
msgstr "Карты"

#: includes/setup/settings.php
msgid "Create New Template"
msgstr "Создать новый шаблон"

#: includes/setup/settings.php
msgid "Map"
msgstr "Карта"

#: includes/setup/settings.php
msgid "Templates"
msgstr "Шаблоны"

#: includes/setup/settings.php
msgid "Google API Key"
msgstr "Ключ Google API"

#: includes/setup/settings.php
msgid "The Google Maps API Key is not required but highly recommended, get more info at <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Documentation</a>."
msgstr "Ключ API Google Maps не обязателен, но настоятельно рекомендуется; подробнее см. в <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>документации Google</a>."

#: includes/setup/settings.php
msgid "Geolocation URL"
msgstr "URL геолокации"

#: includes/setup/settings.php
msgid "Enter the URL of the IP to Geolocation lookup service.  Every devices IP address will be tested against this location service if not set to determine the devices Geolocation.  The devices IP address will be appended to the end of this URL."
msgstr "Введите URL-адрес сервиса геолокации по IP. IP-адрес каждого устройства с незаданными координатами будет проверяться через этот сервис для определения его геолокации. IP-адрес устройства будет добавлен в конец этого URL-адреса."

#: includes/setup/settings.php
msgid "Initial Latitude"
msgstr "Начальная широта"

#: includes/setup/settings.php
msgid "Defines the centering of the map"
msgstr "Задаёт центрирование карты"

#: includes/setup/settings.php
msgid "Initial Longitude"
msgstr "Начальная долгота"

#: includes/setup/settings.php
msgid "Initial Elevation"
msgstr "Начальная высота"

#: includes/setup/settings.php
msgid "Defines the elevation of the map from 0 - 12"
msgstr "Задаёт высоту (уровень) карты от 0 до 12"

#: includes/setup/settings.php
msgid "Display Settings"
msgstr "Настройки отображения"

#: includes/setup/settings.php
msgid "Display Disabled Devices"
msgstr "Отображать отключённые устройства"

#: includes/setup/settings.php
msgid "Allow the display of disabled Devices on the Map"
msgstr "Разрешить отображение отключённых устройств на карте"

#: includes/setup/settings.php
msgid "Coverage Overlay"
msgstr "Слой покрытия"

#: includes/setup/settings.php
msgid "Draws a transparent circle around an AP with a radius equal to the furthest node in the same subnet"
msgstr "Рисует прозрачный круг вокруг точки доступа с радиусом, равным расстоянию до самого дальнего узла в той же подсети"

#: includes/setup/settings.php
msgid "Map Refresh"
msgstr "Обновление карты"

#: includes/setup/settings.php
msgid "Refreshes map after set minutes. Recommend set to poller interval, 0 to disable."
msgstr "Обновляет карту через заданное число минут. Рекомендуется задать равным интервалу опросчика; 0 — отключить."

#: includes/setup/settings.php
msgid "Overlay Settings"
msgstr "Настройки наложения"

#: includes/setup/settings.php
msgid "Tab Radius (Required)"
msgstr "Радиус вкладки (обязательно)"

#: includes/setup/settings.php
msgid "Defines radius to combine points into one. (default: 0.0003)"
msgstr "Задаёт радиус объединения точек в одну (по умолчанию: 0.0003)"

#: includes/setup/settings.php
msgid "Fill Color"
msgstr "Цвет заливки"

#: includes/setup/settings.php
msgid "The overlay circle fill color as FFFFFF"
msgstr "Цвет заливки круга наложения в формате FFFFFF"

#: includes/setup/settings.php
msgid "Ring Color"
msgstr "Цвет кольца"

#: includes/setup/settings.php
msgid "Defines the outer rim color as FFFFFF"
msgstr "Задаёт цвет внешней границы в формате FFFFFF"

#: includes/setup/settings.php
msgid "Ring Width"
msgstr "Ширина кольца"

#: includes/setup/settings.php
msgid "Outer Ring width"
msgstr "Ширина внешнего кольца"

#: includes/setup/settings.php
msgid "Fill Opacity"
msgstr "Непрозрачность заливки"

#: includes/setup/settings.php
msgid "Defines the fill opacity between 0 and 1"
msgstr "Задаёт непрозрачность заливки от 0 до 1"

#: includes/setup/settings.php
msgid "Ring Opacity"
msgstr "Непрозрачность кольца"

#: includes/setup/settings.php
msgid "Defines the ring opacity between 0 and 1"
msgstr "Задаёт непрозрачность контура кольца от 0 до 1"

#: includes/setup/settings.php
msgid "Quality"
msgstr "Качество"

#: includes/setup/settings.php
msgid "Number of divisions in circle (preferably > 15) greater numbers can slow down browser performance."
msgstr "Количество сегментов окружности (желательно > 15); большие значения могут замедлить работу браузера."

#: setup.php
msgid "Configure Maps"
msgstr "Настроить карты"

#: setup.php
msgid "View Maps"
msgstr "Просмотр карт"

#: setup.php
msgid "Map Settings"
msgstr "Настройки карты"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Включение оверлея"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Отключить только для графика, не включаемого в наложение покрытия."

#: setup.php
msgid "Latitude"
msgstr "Широта"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Координаты широты устройства"

#: setup.php
msgid "Longitude"
msgstr "Долгота"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Координаты долготы устройства"

#: setup.php
msgid "Starting Degree"
msgstr "Начальный градус"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "Начальный градус для направленной области от 0 до 360"

#: setup.php
msgid "Stopping Degree"
msgstr "Конечный градус"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Конечный градус для направленной зоны должна быть больше начальной степени"

#: setup.php
msgid "Specify Radius"
msgstr "Укажите радиус"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Вручную укажите радиус точки доступа. Установите 0, чтобы определить радиус на основе сгруппированных устройств"

#: setup.php
msgid "Group ID"
msgstr "ID группы"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "Группы определяют, какие устройства включаются в наложение покрытия. Будет проверяться по номеру группы устройств AP. 0 для отключения"
