#: gpstemplates.php
msgid "Device Template"
msgstr "Isifanekiso Sedivayisi"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Khetha Isifanekiso Sedivayisi esizokwakhelwa kuso lolu hlobo Lwesifanekiso Semephu."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Khetha Isithombe Esizoboniswa Uma Idivayisi Iphezulu"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Khetha Isithombe Esizoboniswa Uma Idivayisi Ilulama"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Khetha Isithombe Esizoboniswa Uma Idivayisi Iphansi"

#: gpstemplates.php
msgid "Access Point"
msgstr "Iphoyinti Lokufinyelela"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Ingabe lesi Sifanekiso Sedivayisi simele i-Access Point."

#: gpstemplates.php
msgid "No"
msgstr "Cha"

#: gpstemplates.php
msgid "Yes"
msgstr "Yebo"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "Ukuhlela Isifanekiso Semephu"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "I-IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "Qala Kabusha"

#: includes/polling/processregion.php
