msgstr "Faux"

#: gpstemplates.php
msgid "Device Template"
msgstr "Modèle d'équipement"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Choisissez le modèle d'équipement sur lequel baser ce type de modèle de carte."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Sélectionner l'image à afficher pour un équipement actif"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Sélectionner l'image à afficher pour un équipement en récupération"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Sélectionner l'image à afficher pour un équipement inactif"

#: gpstemplates.php
msgid "Access Point"
msgstr "Point d'accès"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Indique si ce modèle d'équipement représente un point d'accès."

#: gpstemplates.php
msgid "No"
msgstr "Non"

#: gpstemplates.php
msgid "Yes"
msgstr "Oui"

#: gpstemplates.php
