msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "Assicurarsi di configurare prima correttamente Mappe in Impostazioni > Mappe"

#: gpstemplates.php
msgid "Delete"
msgstr "Elimina"

#: gpstemplates.php
msgid "Map Templates"
msgstr "Modelli di mappa"

#: gpstemplates.php
