#: gpstemplates.php
msgid "Device Template"
msgstr "Modello del dispositivo"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Scegliere il modello di dispositivo su cui basare questo tipo di modello di mappa."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Seleziona l'immagine da mostrare per un dispositivo attivo"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Seleziona l'immagine da mostrare per un dispositivo in ripristino"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Seleziona l'immagine da mostrare per un dispositivo inattivo"

#: gpstemplates.php
msgid "Access Point"
msgstr "Punto d'accesso"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Questo modello di dispositivo rappresenta un Access Point."

#: gpstemplates.php
msgid "No"
msgstr "No"

#: gpstemplates.php
