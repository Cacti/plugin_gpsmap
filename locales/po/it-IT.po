msgstr "Modifica modello mappa"

#: setup.php
msgid "Configure Maps"
msgstr "Configura mappe"

#: setup.php
msgid "View Maps"
msgstr "Visualizza mappe"

#: setup.php
msgid "Map Settings"
msgstr "Impostazioni Mappa"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Inclusione overlay"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Disabilita per tracciare solo l'host, non incluso nella sovrapposizione di copertura."

#: setup.php
msgid "Latitude"
msgstr "Latitudine"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Le coordinate di latitudine dei dispositivi"

#: setup.php
msgid "Longitude"
msgstr "Longitudine"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Le coordinate di longitudine dei dispositivi"

#: setup.php
msgid "Starting Degree"
msgstr "Grado iniziale"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "Grado iniziale per l'area direzionale tra 0 e 360"

#: setup.php
msgid "Stopping Degree"
msgstr "Grado finale"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Grado finale per l'area direzionale, deve essere maggiore del Grado iniziale"

#: setup.php
msgid "Specify Radius"
msgstr "Specifica raggio"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Specifica manualmente il raggio per l'Access Point. Imposta su 0 per determinare il raggio in base ai dispositivi raggruppati"

#: setup.php
msgid "Group ID"
msgstr "ID Gruppo"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "I gruppi definiscono quali dispositivi sono inclusi nell'overlay di copertura. Verrà verificato rispetto al numero di gruppo del dispositivo AP. 0 per disabilitare"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "Ricomincia"

#: includes/polling/processregion.php
msgid "Print"
msgstr "Stampa"

#: includes/setup/settings.php includes/setup/tabs.php
msgid "Maps"
msgstr "Mappe"

#: includes/setup/settings.php
msgid "Create New Template"
msgstr "Crea nuovo modello"

#: includes/setup/settings.php
msgid "Map"
msgstr "Mappa"

#: includes/setup/settings.php
msgid "Templates"
msgstr "Modelli"

#: includes/setup/settings.php
msgid "Google API Key"
msgstr "Chiave API Google"

#: includes/setup/settings.php
msgid "The Google Maps API Key is not required but highly recommended, get more info at <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Documentation</a>."
msgstr "La chiave API di Google Maps non è obbligatoria ma altamente consigliata; ulteriori informazioni nella <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>documentazione Google</a>."

#: includes/setup/settings.php
msgid "Geolocation URL"
msgstr "URL di geolocalizzazione"

#: includes/setup/settings.php
msgid "Enter the URL of the IP to Geolocation lookup service.  Every devices IP address will be tested against this location service if not set to determine the devices Geolocation.  The devices IP address will be appended to the end of this URL."
msgstr "Inserisci l'URL del servizio di ricerca da IP a geolocalizzazione. Se non impostato, l'indirizzo IP di ogni dispositivo verrà testato con questo servizio per determinarne la geolocalizzazione. L'indirizzo IP del dispositivo verrà aggiunto alla fine di questo URL."

#: includes/setup/settings.php
msgid "Initial Latitude"
msgstr "Latitudine iniziale"

#: includes/setup/settings.php
msgid "Defines the centering of the map"
msgstr "Definisce la centratura della mappa"

#: includes/setup/settings.php
msgid "Initial Longitude"
msgstr "Longitudine iniziale"

#: includes/setup/settings.php
msgid "Initial Elevation"
msgstr "Altitudine iniziale"

#: includes/setup/settings.php
msgid "Defines the elevation of the map from 0 - 12"
msgstr "Definisce l'elevazione della mappa da 0 a 12"

#: includes/setup/settings.php
msgid "Display Settings"
msgstr "Impostazioni di visualizzazione"

#: includes/setup/settings.php
msgid "Display Disabled Devices"
msgstr "Visualizza dispositivi disabilitati"

#: includes/setup/settings.php
msgid "Allow the display of disabled Devices on the Map"
msgstr "Consenti la visualizzazione dei dispositivi disabilitati sulla mappa"

#: includes/setup/settings.php
msgid "Coverage Overlay"
msgstr "Sovrapposizione copertura"

#: includes/setup/settings.php
msgid "Draws a transparent circle around an AP with a radius equal to the furthest node in the same subnet"
msgstr "Disegna un cerchio trasparente attorno a un AP con raggio pari al nodo più distante nella stessa subnet"

#: includes/setup/settings.php
msgid "Map Refresh"
msgstr "Aggiornamento mappa"

#: includes/setup/settings.php
msgid "Refreshes map after set minutes. Recommend set to poller interval, 0 to disable."
msgstr "Aggiorna la mappa dopo i minuti impostati. Si consiglia di impostare all'intervallo del Poller, 0 per disabilitare."

#: includes/setup/settings.php
msgid "Overlay Settings"
msgstr "Impostazioni sovrapposizione"

#: includes/setup/settings.php
msgid "Tab Radius (Required)"
msgstr "Raggio scheda (Obbligatorio)"

#: includes/setup/settings.php
msgid "Defines radius to combine points into one. (default: 0.0003)"
msgstr "Definisce il raggio per combinare i punti in uno solo. (predefinito: 0.0003)"

#: includes/setup/settings.php
msgid "Fill Color"
msgstr "Colore di riempimento"

#: includes/setup/settings.php
msgid "The overlay circle fill color as FFFFFF"
msgstr "Il colore di riempimento del cerchio in sovrimpressione come FFFFFF"

#: includes/setup/settings.php
msgid "Ring Color"
msgstr "Colore anello"

#: includes/setup/settings.php
msgid "Defines the outer rim color as FFFFFF"
msgstr "Definisce il colore del bordo esterno come FFFFFF"

#: includes/setup/settings.php
msgid "Ring Width"
msgstr "Larghezza anello"

#: includes/setup/settings.php
msgid "Outer Ring width"
msgstr "Larghezza anello esterno"

#: includes/setup/settings.php
msgid "Fill Opacity"
msgstr "Opacità di riempimento"

#: includes/setup/settings.php
msgid "Defines the fill opacity between 0 and 1"
msgstr "Definisce l'opacità di riempimento tra 0 e 1"

#: includes/setup/settings.php
msgid "Ring Opacity"
msgstr "Opacità anello"

#: includes/setup/settings.php
msgid "Defines the ring opacity between 0 and 1"
msgstr "Definisce l'opacità dell'anello tra 0 e 1"

#: includes/setup/settings.php
msgid "Quality"
msgstr "Qualità"

#: includes/setup/settings.php
msgid "Number of divisions in circle (preferably > 15) greater numbers can slow down browser performance."
msgstr "Numero di suddivisioni nel cerchio (preferibilmente > 15); valori superiori possono rallentare le prestazioni del browser."
