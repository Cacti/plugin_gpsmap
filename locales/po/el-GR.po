msgid "Map Templates"
msgstr "Πρότυπα χάρτη"

#: gpstemplates.php
msgid "Host Template"
msgstr "Πρότυπο κεντρικού υπολογιστή"

#: gpstemplates.php
msgid "Up Image"
msgstr "Εικόνα ενεργού"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "Εικόνα κατάστασης ανάκτησης"

#: gpstemplates.php
msgid "Down Image"
msgstr "Εικόνα ανενεργής κατάστασης"

#: gpstemplates.php
msgid "Is AP"
msgstr "Είναι AP"

