msgstr "Hindura Inyandikorugero y'Ikarita"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "Tangira bushya"

#: includes/polling/processregion.php
