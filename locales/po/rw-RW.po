msgstr "Inyandikorugero y'igikoresho"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Hitamo Inyandikorugero y'Igikoresho yo gushingiraho ubu bwoko bw'Inyandikorugero y'Ikarita."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Hitamo Ishusho yo Kwerekana ku Gikoresho Gikora"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Hitamo Ishusho yo Kwerekana ku Gikoresho Kirimo Kugaruka"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Hitamo Ishusho yo Kwerekana ku Gikoresho Cyahagaze"

#: gpstemplates.php
msgid "Access Point"
msgstr "Ingingo yo kwinjiriraho"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Ese iyi Nyandikorugero y'Igikoresho ihagarariye Access Point."

#: gpstemplates.php
msgid "No"
msgstr "Oya"

#: gpstemplates.php
msgid "Yes"
msgstr "Yego"

#: gpstemplates.php
