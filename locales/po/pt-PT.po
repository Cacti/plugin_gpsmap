msgstr "Edição de modelo de mapa"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "Recomeçar"

#: includes/polling/processregion.php
