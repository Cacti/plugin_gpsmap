#: gpstemplates.php
msgid "Device Template"
msgstr "Modelo do dispositivo"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Escolha o modelo de dispositivo no qual basear este tipo de modelo de mapa."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Selecione a imagem a mostrar para um dispositivo ativo"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Selecione a imagem a mostrar para um dispositivo em recuperação"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Selecione a imagem a mostrar para um dispositivo inativo"

#: gpstemplates.php
msgid "Access Point"
msgstr "Ponto de acesso"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Este modelo de dispositivo representa um ponto de acesso."

#: gpstemplates.php
msgid "No"
msgstr "Não"

#: gpstemplates.php
msgid "Yes"
msgstr "Sim"

#: gpstemplates.php
