#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "يرجى التأكد من تكوين الخرائط بشكل صحيح أولًا ضمن إعدادات > الخرائط"

#: gpstemplates.php
msgid "Delete"
msgstr "حذف"

#: gpstemplates.php includes/setup/settings.php
msgid "Map Templates"
msgstr "قوالب الخرائط"

#: gpstemplates.php
msgid "Host Template"
msgstr "قالب المستضيف Host"

#: gpstemplates.php
msgid "Up Image"
msgstr "صورة حالة التشغيل"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "صورة الاسترداد"

#: gpstemplates.php
