#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "Certifique-se de configurar primeiro o Maps corretamente em Configurações > Maps"

#: gpstemplates.php
msgid "Delete"
msgstr "Excluir"

#: gpstemplates.php
msgid "Map Templates"
msgstr "Modelos de mapa"

#: gpstemplates.php
msgid "Host Template"
msgstr "Modelo de host"

#: gpstemplates.php
msgid "Up Image"
msgstr "Imagem de ativo"

#: gpstemplates.php
