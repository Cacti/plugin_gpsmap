msgstr "Chọn Mẫu thiết bị làm cơ sở cho loại Mẫu bản đồ này."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Chọn hình ảnh hiển thị cho thiết bị đang hoạt động"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Chọn hình ảnh hiển thị cho thiết bị đang khôi phục"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Chọn hình ảnh hiển thị cho thiết bị ngừng hoạt động"

#: gpstemplates.php
msgid "Access Point"
msgstr "Điểm truy cập"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Mẫu thiết bị này có đại diện cho một điểm truy cập (Access Point) không."

