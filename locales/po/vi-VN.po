#: includes/setup/settings.php includes/setup/tabs.php
msgid "Maps"
msgstr "Bản đồ"

#: includes/setup/settings.php
msgid "Create New Template"
msgstr "Tạo mẫu mới"

#: includes/setup/settings.php
msgid "Map"
msgstr "Bản đồ"

#: includes/setup/settings.php
msgid "Templates"
msgstr "Giao diện"

#: includes/setup/settings.php
msgid "Google API Key"
msgstr "Khóa Google API"

#: includes/setup/settings.php
msgid "The Google Maps API Key is not required but highly recommended, get more info at <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Documentation</a>."
msgstr "Khóa API Google Maps không bắt buộc nhưng được khuyến nghị mạnh mẽ, xem thêm thông tin tại <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Tài liệu Google</a>."

#: includes/setup/settings.php
msgid "Geolocation URL"
msgstr "URL định vị địa lý"

#: includes/setup/settings.php
msgid "Enter the URL of the IP to Geolocation lookup service.  Every devices IP address will be tested against this location service if not set to determine the devices Geolocation.  The devices IP address will be appended to the end of this URL."
msgstr "Nhập URL của dịch vụ tra cứu IP sang Vị trí địa lý. Địa chỉ IP của mọi thiết bị sẽ được kiểm tra với dịch vụ vị trí này nếu chưa được đặt để xác định Vị trí địa lý của thiết bị. Địa chỉ IP của thiết bị sẽ được nối vào cuối URL này."

#: includes/setup/settings.php
msgid "Initial Latitude"
msgstr "Vĩ độ ban đầu"

#: includes/setup/settings.php
msgid "Defines the centering of the map"
msgstr "Xác định vị trí căn giữa của bản đồ"

#: includes/setup/settings.php
msgid "Initial Longitude"
msgstr "Kinh độ ban đầu"

#: includes/setup/settings.php
msgid "Initial Elevation"
msgstr "Độ cao ban đầu"

#: includes/setup/settings.php
msgid "Defines the elevation of the map from 0 - 12"
msgstr "Xác định độ cao của bản đồ từ 0 - 12"

#: includes/setup/settings.php
msgid "Display Settings"
msgstr "Cài đặt hiển thị"

#: includes/setup/settings.php
msgid "Display Disabled Devices"
msgstr "Hiển thị thiết bị đã vô hiệu hóa"

#: includes/setup/settings.php
msgid "Allow the display of disabled Devices on the Map"
msgstr "Cho phép hiển thị các thiết bị đã bị vô hiệu hóa trên bản đồ"

#: includes/setup/settings.php
msgid "Coverage Overlay"
msgstr "Lớp phủ vùng phủ sóng"

#: includes/setup/settings.php
msgid "Draws a transparent circle around an AP with a radius equal to the furthest node in the same subnet"
msgstr "Vẽ một vòng tròn trong suốt xung quanh AP với bán kính bằng nút xa nhất trong cùng mạng con"

#: includes/setup/settings.php
msgid "Map Refresh"
msgstr "Làm mới bản đồ"

#: includes/setup/settings.php
msgid "Refreshes map after set minutes. Recommend set to poller interval, 0 to disable."
msgstr "Làm mới bản đồ sau số phút đã đặt. Khuyến nghị đặt bằng khoảng thời gian của Poller, đặt 0 để tắt."

#: includes/setup/settings.php
msgid "Overlay Settings"
msgstr "Cài đặt lớp phủ"

#: includes/setup/settings.php
msgid "Tab Radius (Required)"
msgstr "Bán kính Tab (Bắt buộc)"

#: includes/setup/settings.php
msgid "Defines radius to combine points into one. (default: 0.0003)"
msgstr "Xác định bán kính để gộp các điểm thành một. (mặc định: 0.0003)"

#: includes/setup/settings.php
msgid "Fill Color"
msgstr "Màu tô"

#: includes/setup/settings.php
msgid "The overlay circle fill color as FFFFFF"
msgstr "Màu tô vòng tròn lớp phủ dưới dạng FFFFFF"

#: includes/setup/settings.php
msgid "Ring Color"
msgstr "Màu vòng tròn"

#: includes/setup/settings.php
msgid "Defines the outer rim color as FFFFFF"
msgstr "Xác định màu viền ngoài dạng FFFFFF"

#: includes/setup/settings.php
msgid "Ring Width"
msgstr "Độ rộng vòng tròn"

#: includes/setup/settings.php
msgid "Outer Ring width"
msgstr "Độ rộng vòng ngoài"

#: includes/setup/settings.php
msgid "Fill Opacity"
msgstr "Độ mờ màu tô"

#: includes/setup/settings.php
msgid "Defines the fill opacity between 0 and 1"
msgstr "Xác định độ mờ phần tô từ 0 đến 1"

#: includes/setup/settings.php
msgid "Ring Opacity"
msgstr "Độ mờ vòng tròn"

#: includes/setup/settings.php
msgid "Defines the ring opacity between 0 and 1"
msgstr "Xác định độ mờ đường viền vòng từ 0 đến 1"

#: includes/setup/settings.php
msgid "Quality"
msgstr "Chất lượng"

#: includes/setup/settings.php
msgid "Number of divisions in circle (preferably > 15) greater numbers can slow down browser performance."
msgstr "Số phần chia trong hình tròn (nên > 15); số lượng lớn hơn có thể làm chậm hiệu năng trình duyệt."

#: setup.php
msgid "Configure Maps"
msgstr "Cấu hình bản đồ"

#: setup.php
msgid "View Maps"
msgstr "Xem bản đồ"

#: setup.php
msgid "Map Settings"
msgstr "Cài đặt bản đồ"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Bao gồm lớp phủ"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Tắt để chỉ vẽ vị trí máy chủ, không đưa vào lớp phủ vùng phủ sóng."

#: setup.php
msgid "Latitude"
msgstr "Vĩ độ"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Tọa độ vĩ độ của thiết bị"

#: setup.php
msgid "Longitude"
msgstr "Kinh độ"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Tọa độ kinh độ của thiết bị"

#: setup.php
msgid "Starting Degree"
msgstr "Độ bắt đầu"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "Độ bắt đầu cho vùng định hướng trong khoảng từ 0-360"

#: setup.php
msgid "Stopping Degree"
msgstr "Độ dừng"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Độ dừng cho vùng định hướng, phải lớn hơn Độ bắt đầu"

#: setup.php
msgid "Specify Radius"
msgstr "Chỉ định bán kính"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Chỉ định bán kính thủ công cho Access Point. Đặt thành 0 để xác định bán kính dựa trên các thiết bị được nhóm"

#: setup.php
msgid "Group ID"
msgstr "ID Nhóm"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "Các nhóm xác định những thiết bị nào được đưa vào lớp phủ vùng phủ sóng. Sẽ được kiểm tra theo số nhóm thiết bị AP. Đặt 0 để tắt"
