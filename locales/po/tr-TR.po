#: includes/setup/settings.php includes/setup/tabs.php
msgid "Maps"
msgstr "Haritalar"

#: includes/setup/settings.php
msgid "Create New Template"
msgstr "Yeni Şablon Oluştur"

#: includes/setup/settings.php
msgid "Map"
msgstr "Harita"

#: includes/setup/settings.php
msgid "Templates"
msgstr "Şablonlar"

#: includes/setup/settings.php
msgid "Google API Key"
msgstr "Google API Anahtarı"

#: includes/setup/settings.php
msgid "The Google Maps API Key is not required but highly recommended, get more info at <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Documentation</a>."
msgstr "Google Maps API Anahtarı zorunlu değildir ancak kesinlikle önerilir; daha fazla bilgi için <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Belgeleri</a> sayfasına bakın."

#: includes/setup/settings.php
msgid "Geolocation URL"
msgstr "Coğrafi Konum URL'si"

#: includes/setup/settings.php
msgid "Enter the URL of the IP to Geolocation lookup service.  Every devices IP address will be tested against this location service if not set to determine the devices Geolocation.  The devices IP address will be appended to the end of this URL."
msgstr "IP'den Coğrafi Konum arama hizmetinin URL'sini girin. Cihazın coğrafi konumu ayarlanmamışsa, her cihazın IP adresi cihazların Coğrafi Konumunu belirlemek için bu konum hizmetine göre test edilecektir. Cihazın IP adresi bu URL'nin sonuna eklenecektir."

#: includes/setup/settings.php
msgid "Initial Latitude"
msgstr "Başlangıç Enlemi"

#: includes/setup/settings.php
msgid "Defines the centering of the map"
msgstr "Haritanın merkezlemesini tanımlar"

#: includes/setup/settings.php
msgid "Initial Longitude"
msgstr "Başlangıç Boylamı"

#: includes/setup/settings.php
msgid "Initial Elevation"
msgstr "Başlangıç Yüksekliği"

#: includes/setup/settings.php
msgid "Defines the elevation of the map from 0 - 12"
msgstr "Haritanın 0 - 12 arasındaki yükseltisini tanımlar"

#: includes/setup/settings.php
msgid "Display Settings"
msgstr "Görüntü Ayarları"

#: includes/setup/settings.php
msgid "Display Disabled Devices"
msgstr "Devre Dışı Cihazları Görüntüle"

#: includes/setup/settings.php
msgid "Allow the display of disabled Devices on the Map"
msgstr "Devre dışı bırakılmış Cihazların Haritada görüntülenmesine izin ver"

#: includes/setup/settings.php
msgid "Coverage Overlay"
msgstr "Kapsama Katmanı"

#: includes/setup/settings.php
msgid "Draws a transparent circle around an AP with a radius equal to the furthest node in the same subnet"
msgstr "Aynı alt ağdaki en uzak düğüme eşit yarıçapa sahip bir AP etrafında saydam bir daire çizer"

#: includes/setup/settings.php
msgid "Map Refresh"
msgstr "Harita Yenileme"

#: includes/setup/settings.php
msgid "Refreshes map after set minutes. Recommend set to poller interval, 0 to disable."
msgstr "Haritayı belirtilen dakika sonra yeniler. Poller aralığına ayarlanması önerilir, devre dışı bırakmak için 0 girin."

#: includes/setup/settings.php
msgid "Overlay Settings"
msgstr "Katman Ayarları"

#: includes/setup/settings.php
msgid "Tab Radius (Required)"
msgstr "Sekme Yarıçapı (Gerekli)"

#: includes/setup/settings.php
msgid "Defines radius to combine points into one. (default: 0.0003)"
msgstr "Noktaları tek bir noktada birleştirmek için yarıçapı tanımlar. (varsayılan: 0.0003)"

#: includes/setup/settings.php
msgid "Fill Color"
msgstr "Dolgu Rengi"

#: includes/setup/settings.php
msgid "The overlay circle fill color as FFFFFF"
msgstr "FFFFFF biçiminde yer paylaşımlı daire dolgu rengi"

#: includes/setup/settings.php
msgid "Ring Color"
msgstr "Halka Rengi"

#: includes/setup/settings.php
msgid "Defines the outer rim color as FFFFFF"
msgstr "Dış kenar rengini FFFFFF biçiminde tanımlar"

#: includes/setup/settings.php
msgid "Ring Width"
msgstr "Halka Genişliği"

#: includes/setup/settings.php
msgid "Outer Ring width"
msgstr "Dış Halka genişliği"

#: includes/setup/settings.php
msgid "Fill Opacity"
msgstr "Dolgu Opaklığı"

#: includes/setup/settings.php
msgid "Defines the fill opacity between 0 and 1"
msgstr "0 ile 1 arasındaki dolgu opaklığını tanımlar"

#: includes/setup/settings.php
msgid "Ring Opacity"
msgstr "Halka Opaklığı"

#: includes/setup/settings.php
msgid "Defines the ring opacity between 0 and 1"
msgstr "0 ile 1 arasındaki halka opaklığını tanımlar"

#: includes/setup/settings.php
msgid "Quality"
msgstr "Kalite"

#: includes/setup/settings.php
msgid "Number of divisions in circle (preferably > 15) greater numbers can slow down browser performance."
msgstr "Dairedeki bölüm sayısı (tercihen > 15); daha büyük sayılar tarayıcı performansını yavaşlatabilir."

#: setup.php
msgid "Configure Maps"
msgstr "Haritaları Yapılandır"

#: setup.php
msgid "View Maps"
msgstr "Haritaları Görüntüle"

#: setup.php
msgid "Map Settings"
msgstr "Harita Ayarları"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Katman Dahil Etme"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Yalnızca ana bilgisayarı işaretlemek için devre dışı bırakın; kapsama katmanına dahil edilmez."

#: setup.php
msgid "Latitude"
msgstr "Enlem"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Cihazın enlem koordinatları"

#: setup.php
msgid "Longitude"
msgstr "Boylam"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Cihazın boylam koordinatları"

#: setup.php
msgid "Starting Degree"
msgstr "Başlangıç Derecesi"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "0-360 arası yönlü alan için başlangıç derecesi"

#: setup.php
msgid "Stopping Degree"
msgstr "Bitiş Derecesi"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Yönlü alan için bitiş derecesi; Başlangıç Derecesinden büyük olmalıdır"

#: setup.php
msgid "Specify Radius"
msgstr "Yarıçap Belirtin"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Erişim Noktası için yarıçapı el ile belirtin. Yarıçapı gruplandırılmış cihazlara göre belirlemek için 0 olarak ayarlayın"

#: setup.php
msgid "Group ID"
msgstr "Grup ID"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "Gruplar, kapsama katmanına hangi cihazların dahil edileceğini tanımlar. AP cihaz grup numarasına göre kontrol edilecektir. Devre dışı bırakmak için 0 girin"
