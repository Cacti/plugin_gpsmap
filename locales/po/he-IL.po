msgstr "שקר"

#: gpstemplates.php
msgid "Device Template"
msgstr "תבנית התקן"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "בחר את תבנית ההתקן שעליה יתבסס סוג תבנית מפה זה."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "בחר את התמונה להצגה עבור התקן פעיל"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "בחר את התמונה להצגה עבור התקן בהתאוששות"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "בחר את התמונה להצגה עבור התקן לא פעיל"

#: gpstemplates.php
msgid "Access Point"
msgstr "נקודת גישה"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "האם תבנית התקן זו מייצגת נקודת גישה."

#: gpstemplates.php
msgid "No"
msgstr "לא"

#: gpstemplates.php
msgid "Yes"
msgstr "כן"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "עריכת תבנית מפה"

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "התחל מחדש"

#: includes/polling/processregion.php
msgid "Print"
msgstr "הדפס"

#: includes/setup/settings.php includes/setup/tabs.php
msgid "Maps"
msgstr "מפות"

#: includes/setup/settings.php
msgid "Create New Template"
msgstr "צור תבנית חדשה"

#: includes/setup/settings.php
msgid "Map"
msgstr "מפה"

#: includes/setup/settings.php
msgid "Templates"
msgstr "תבניות"

#: includes/setup/settings.php
msgid "Google API Key"
msgstr "מפתח Google API"

#: includes/setup/settings.php
msgid "The Google Maps API Key is not required but highly recommended, get more info at <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Documentation</a>."
msgstr "מפתח API של Google Maps אינו חובה אך מומלץ מאוד; למידע נוסף עיין ב-<a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>תיעוד Google</a>."

#: includes/setup/settings.php
msgid "Geolocation URL"
msgstr "כתובת URL לאיתור מיקום גאוגרפי"

#: includes/setup/settings.php
msgid "Enter the URL of the IP to Geolocation lookup service.  Every devices IP address will be tested against this location service if not set to determine the devices Geolocation.  The devices IP address will be appended to the end of this URL."
msgstr "הזן את כתובת ה-URL של שירות איתור המיקום הגאוגרפי לפי IP. כתובת ה-IP של כל התקן תיבדק מול שירות מיקום זה אם לא הוגדרה כדי לקבוע את המיקום הגאוגרפי של ההתקן. כתובת ה-IP של ההתקן תצורף לסוף כתובת URL זו."

#: includes/setup/settings.php
msgid "Initial Latitude"
msgstr "קו רוחב התחלתי"

#: includes/setup/settings.php
msgid "Defines the centering of the map"
msgstr "מגדיר את מרכוז המפה"

#: includes/setup/settings.php
msgid "Initial Longitude"
msgstr "קו אורך התחלתי"

#: includes/setup/settings.php
msgid "Initial Elevation"
msgstr "גובה התחלתי"

#: includes/setup/settings.php
msgid "Defines the elevation of the map from 0 - 12"
msgstr "מגדיר את גובה המפה בין 0 ל-12"

#: includes/setup/settings.php
msgid "Display Settings"
msgstr "הגדרות תצוגה"

#: includes/setup/settings.php
msgid "Display Disabled Devices"
msgstr "הצג התקנים מושבתים"

#: includes/setup/settings.php
msgid "Allow the display of disabled Devices on the Map"
msgstr "אפשר הצגה של התקנים מושבתים במפה"

#: includes/setup/settings.php
msgid "Coverage Overlay"
msgstr "שכבת כיסוי"

#: includes/setup/settings.php
msgid "Draws a transparent circle around an AP with a radius equal to the furthest node in the same subnet"
msgstr "מצייר עיגול שקוף סביב נקודת גישה (AP) ברדיוס השווה לצומת הרחוק ביותר באותה תת-רשת"

#: includes/setup/settings.php
msgid "Map Refresh"
msgstr "רענון מפה"

#: includes/setup/settings.php
msgid "Refreshes map after set minutes. Recommend set to poller interval, 0 to disable."
msgstr "מרענן את המפה לאחר מספר הדקות שנקבע. מומלץ להגדיר למרווח ה-Poller, או 0 להשבתה."

#: includes/setup/settings.php
msgid "Overlay Settings"
msgstr "הגדרות שכבת-על"

#: includes/setup/settings.php
msgid "Tab Radius (Required)"
msgstr "רדיוס לשונית (חובה)"

#: includes/setup/settings.php
msgid "Defines radius to combine points into one. (default: 0.0003)"
msgstr "מגדיר רדיוס לאיחוד נקודות לאחת. (ברירת מחדל: 0.0003)"

#: includes/setup/settings.php
msgid "Fill Color"
msgstr "צבע מילוי"

#: includes/setup/settings.php
msgid "The overlay circle fill color as FFFFFF"
msgstr "צבע המילוי של עיגול השכבה בפורמט FFFFFF"

#: includes/setup/settings.php
msgid "Ring Color"
msgstr "צבע טבעת"

#: includes/setup/settings.php
msgid "Defines the outer rim color as FFFFFF"
msgstr "מגדיר את צבע השפה החיצונית כ-FFFFFF"

#: includes/setup/settings.php
msgid "Ring Width"
msgstr "רוחב טבעת"

#: includes/setup/settings.php
msgid "Outer Ring width"
msgstr "רוחב טבעת חיצונית"

#: includes/setup/settings.php
msgid "Fill Opacity"
msgstr "אטימות מילוי"

#: includes/setup/settings.php
msgid "Defines the fill opacity between 0 and 1"
msgstr "מגדיר את אטימות המילוי בין 0 ל-1"

#: includes/setup/settings.php
msgid "Ring Opacity"
msgstr "שקיפות טבעת"

#: includes/setup/settings.php
msgid "Defines the ring opacity between 0 and 1"
msgstr "מגדיר את אטימות הטבעת בין 0 ל-1"

#: includes/setup/settings.php
msgid "Quality"
msgstr "איכות"

#: includes/setup/settings.php
msgid "Number of divisions in circle (preferably > 15) greater numbers can slow down browser performance."
msgstr "מספר החלוקות במעגל (רצוי > 15); מספרים גדולים יותר עלולים להאט את ביצועי הדפדפן."

#: setup.php
msgid "Configure Maps"
msgstr "הגדרת מפות"

#: setup.php
msgid "View Maps"
msgstr "הצג מפות"

#: setup.php
msgid "Map Settings"
msgstr "הגדרות מפה"

#: setup.php
msgid "Overlay Inclusion"
msgstr "הכללת שכבת-על"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "השבת כדי להציג את המארח בלבד, ללא הכללה בשכבת הכיסוי."

#: setup.php
msgid "Latitude"
msgstr "קו רוחב"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "קואורדינטות קו הרוחב של ההתקנים"

#: setup.php
msgid "Longitude"
msgstr "קו אורך"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "קואורדינטות קו האורך של ההתקנים"

#: setup.php
msgid "Starting Degree"
msgstr "מעלת התחלה"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "מעלת התחלה לאזור כיווני בין 0-360"

#: setup.php
msgid "Stopping Degree"
msgstr "מעלת סיום"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "מעלת סיום לאזור כיווני, חייבת להיות גדולה ממעלת ההתחלה"

#: setup.php
msgid "Specify Radius"
msgstr "ציין רדיוס"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "ציין ידנית רדיוס עבור נקודת הגישה. הגדר ל-0 כדי לקבוע את הרדיוס בהתבסס על התקנים מקובצים"

#: setup.php
msgid "Group ID"
msgstr "מזהה הקבוצה"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "קבוצות מגדירות אילו התקנים נכללים בשכבת הכיסוי. ייבדק מול מספר קבוצת ההתקנים של נקודת הגישה (AP). 0 להשבתה"
