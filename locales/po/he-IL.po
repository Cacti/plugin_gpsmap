#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "אנא הקפד להגדיר תחילה את המפות כראוי תחת הגדרות > מפות"

#: gpstemplates.php
msgid "Delete"
msgstr "מחק"

#: gpstemplates.php includes/setup/settings.php
msgid "Map Templates"
msgstr "תבניות מפה"

#: gpstemplates.php
msgid "Host Template"
msgstr "תבנית מארח"

#: gpstemplates.php
msgid "Up Image"
msgstr "תמונת מצב פעיל"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "תמונת התאוששות"

#: gpstemplates.php
msgid "Down Image"
msgstr "תמונה למצב לא פעיל"

#: gpstemplates.php
msgid "Is AP"
msgstr "האם AP"

#: gpstemplates.php
