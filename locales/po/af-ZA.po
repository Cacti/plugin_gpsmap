#: gpstemplates.php
msgid "Device Template"
msgstr "Toestelsjabloon"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Kies die Toestelsjabloon waarop hierdie Kaartsjabloon-tipe gebaseer moet word."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Kies die Beeld om te Wys vir 'n Toestel wat Op is"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Kies die Beeld om vir 'n Herstellende Toestel te Wys"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Kies die Beeld om te Wys vir 'n Toestel wat Af is"

#: gpstemplates.php
msgid "Access Point"
msgstr "Toegangspunt"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Verteenwoordig hierdie toestelsjabloon 'n toegangspunt."

#: gpstemplates.php
msgid "No"
msgstr "Nee"

#: gpstemplates.php
