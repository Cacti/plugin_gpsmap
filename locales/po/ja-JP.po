#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "まず、[設定] > [マップ] でマップを正しく設定してください"

#: gpstemplates.php
msgid "Delete"
msgstr "削除"

#: gpstemplates.php includes/setup/settings.php
msgid "Map Templates"
msgstr "マップテンプレート"

#: gpstemplates.php
msgid "Host Template"
msgstr "ホストテンプレート"

#: gpstemplates.php
msgid "Up Image"
msgstr "稼働時画像"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "画像の復元中"

#: gpstemplates.php
msgid "Down Image"
msgstr "ダウン時の画像"

#: gpstemplates.php
msgid "Is AP"
msgstr "AP かどうか"

#: gpstemplates.php
msgid "True"
msgstr "有効"

#: gpstemplates.php
