#: gpstemplates.php
msgid "Device Template"
msgstr "Kiolezo cha Kifaa"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Chagua Kiolezo cha Kifaa ili kuunda msingi wa aina hii ya Kiolezo cha Ramani."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Chagua Picha ya Kuonyesha kwa Kifaa Kinachofanya Kazi"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Chagua Picha ya Kuonyesha kwa Kifaa Kinachorejea"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Chagua Picha ya Kuonyesha kwa Kifaa Kilichozima"

#: gpstemplates.php
msgid "Access Point"
msgstr "Sehemu ya Kufikia"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Je, Kiolezo hiki cha Kifaa kinawakilisha Access Point."

#: gpstemplates.php
msgid "No"
msgstr "Hapana"

#: gpstemplates.php
msgid "Yes"
msgstr "Ndiyo"

