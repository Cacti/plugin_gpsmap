msgstr "Misafidiana ny sary aseho ho an'ny Fitaovana mandeha"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Misafidiana ny sary aseho ho an'ny Fitaovana miverina miasa"

#: gpstemplates.php
