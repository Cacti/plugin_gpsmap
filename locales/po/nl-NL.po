#: gpstemplates.php
msgid "Device Template"
msgstr "Apparaatsjabloon"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Kies de apparaatsjabloon waarop dit type kaartsjabloon wordt gebaseerd."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Selecteer de afbeelding die moet worden weergegeven voor een actief apparaat"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Selecteer de afbeelding die moet worden weergegeven voor een herstellend apparaat"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Selecteer de afbeelding die moet worden weergegeven voor een inactief apparaat"

#: gpstemplates.php
msgid "Access Point"
msgstr "Toegangspunt"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Vertegenwoordigt dit apparaatsjabloon een accesspoint."

#: gpstemplates.php
msgid "No"
msgstr "Nee"

