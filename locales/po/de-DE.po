#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "Bitte stellen Sie sicher, dass Sie Maps zuerst unter Einstellungen > Maps korrekt konfigurieren"

#: gpstemplates.php
msgid "Delete"
msgstr "Löschen"

#: gpstemplates.php
msgid "Map Templates"
msgstr "Kartenvorlagen"

#: gpstemplates.php
msgid "Host Template"
msgstr "Host-Vorlage"

#: gpstemplates.php
msgid "Up Image"
msgstr "Aktiv-Bild"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "Wiederherstellungsbild"

#: gpstemplates.php
msgid "Down Image"
msgstr "Bild für Nicht erreichbar"

#: gpstemplates.php
msgid "Is AP"
msgstr "Ist AP"

#: gpstemplates.php
msgid "True"
msgstr "Wahr"

#: gpstemplates.php
msgid "False"
msgstr "Falsch"

#: gpstemplates.php
msgid "Device Template"
msgstr "Zielsystem Schablone"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Wählen Sie die Gerätevorlage, auf der dieser Kartenvorlagentyp basieren soll."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Wählen Sie das Bild aus, das für ein erreichbares Gerät angezeigt werden soll"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Wählen Sie das Bild aus, das für ein Gerät in Wiederherstellung angezeigt werden soll"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Wählen Sie das Bild aus, das für ein nicht erreichbares Gerät angezeigt werden soll"

#: gpstemplates.php
msgid "Access Point"
msgstr "Access Point"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Stellt diese Gerätevorlage einen Access Point dar?"

#: gpstemplates.php
msgid "No"
msgstr "Nein"

#: gpstemplates.php
msgid "Yes"
msgstr "Ja"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "Kartenvorlage bearbeiten"

#: setup.php
msgid "Configure Maps"
msgstr "Karten konfigurieren"

#: setup.php
msgid "View Maps"
msgstr "Karten anzeigen"

#: setup.php
msgid "Map Settings"
msgstr "Karten-Einstellungen"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Overlay-Einbindung"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Deaktivieren, um nur den Host darzustellen, ohne Einbeziehung in das Abdeckungs-Overlay."

#: setup.php
msgid "Latitude"
msgstr "Breitengrad"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Die Breitengrad-Koordinaten des Geräts"

#: setup.php
msgid "Longitude"
msgstr "Längengrad"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Die Längengrad-Koordinaten des Geräts"

#: setup.php
msgid "Starting Degree"
msgstr "Startgrad"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "Startgrad für den Richtungsbereich zwischen 0 und 360"

#: setup.php
msgid "Stopping Degree"
msgstr "Stoppgrad"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Stoppgrad für den Richtungsbereich, muss größer als der Startgrad sein"

#: setup.php
msgid "Specify Radius"
msgstr "Radius angeben"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Radius für den Access Point manuell angeben. Auf 0 setzen, um den Radius anhand gruppierter Geräte zu bestimmen."

#: setup.php
msgid "Group ID"
msgstr "Gruppen ID"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "Gruppen legen fest, welche Geräte in der Abdeckungsüberlagerung enthalten sind. Wird mit der AP-Gerätegruppennummer abgeglichen. 0 zum Deaktivieren."

#: includes/polling/processregion.php
#, php-format
msgid "IP %s"
msgstr "IP %s"

#: includes/polling/processregion.php
msgid "Start Over"
msgstr "Neu beginnen"

#: includes/polling/processregion.php
msgid "Print"
msgstr "Drucken"

#: includes/setup/settings.php includes/setup/tabs.php
msgid "Maps"
msgstr "Karten"

#: includes/setup/settings.php
msgid "Create New Template"
msgstr "Neue Vorlage erstellen"

#: includes/setup/settings.php
msgid "Map"
msgstr "Karte"

#: includes/setup/settings.php
msgid "Templates"
msgstr "Schablonen"

#: includes/setup/settings.php
msgid "Google API Key"
msgstr "Google-API-Schlüssel"

#: includes/setup/settings.php
msgid "The Google Maps API Key is not required but highly recommended, get more info at <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google Documentation</a>."
msgstr "Der Google Maps API-Schlüssel ist nicht erforderlich, wird aber dringend empfohlen. Weitere Informationen finden Sie in der <a href='https://developers.google.com/maps/documentation/javascript/tutorial#api_key'>Google-Dokumentation</a>."

#: includes/setup/settings.php
msgid "Geolocation URL"
msgstr "Geolokalisierungs-URL"

#: includes/setup/settings.php
msgid "Enter the URL of the IP to Geolocation lookup service.  Every devices IP address will be tested against this location service if not set to determine the devices Geolocation.  The devices IP address will be appended to the end of this URL."
msgstr "Geben Sie die URL des IP-zu-Geolokalisierungs-Dienstes ein. Die IP-Adresse jedes Geräts wird gegen diesen Standortdienst geprüft, sofern nicht festgelegt, um die Geolokalisierung des Geräts zu bestimmen. Die IP-Adresse des Geräts wird an das Ende dieser URL angehängt."

#: includes/setup/settings.php
msgid "Initial Latitude"
msgstr "Anfänglicher Breitengrad"

#: includes/setup/settings.php
msgid "Defines the centering of the map"
msgstr "Legt die Zentrierung der Karte fest"

#: includes/setup/settings.php
msgid "Initial Longitude"
msgstr "Anfänglicher Längengrad"

#: includes/setup/settings.php
msgid "Initial Elevation"
msgstr "Anfängliche Höhe"

#: includes/setup/settings.php
msgid "Defines the elevation of the map from 0 - 12"
msgstr "Legt die Höhe der Karte von 0 - 12 fest"

#: includes/setup/settings.php
msgid "Display Settings"
msgstr "Anzeigeeinstellungen"

#: includes/setup/settings.php
msgid "Display Disabled Devices"
msgstr "Deaktivierte Geräte anzeigen"

#: includes/setup/settings.php
msgid "Allow the display of disabled Devices on the Map"
msgstr "Anzeige deaktivierter Geräte auf der Karte zulassen"

#: includes/setup/settings.php
msgid "Coverage Overlay"
msgstr "Abdeckungs-Overlay"

#: includes/setup/settings.php
msgid "Draws a transparent circle around an AP with a radius equal to the furthest node in the same subnet"
msgstr "Zeichnet einen transparenten Kreis um einen AP mit einem Radius, der dem am weitesten entfernten Knoten im selben Subnetz entspricht"

#: includes/setup/settings.php
msgid "Map Refresh"
msgstr "Kartenaktualisierung"

#: includes/setup/settings.php
msgid "Refreshes map after set minutes. Recommend set to poller interval, 0 to disable."
msgstr "Aktualisiert die Karte nach der festgelegten Minutenanzahl. Empfohlen wird das Poller-Intervall, 0 zum Deaktivieren."

#: includes/setup/settings.php
msgid "Overlay Settings"
msgstr "Overlay-Einstellungen"

#: includes/setup/settings.php
msgid "Tab Radius (Required)"
msgstr "Tab-Radius (erforderlich)"

#: includes/setup/settings.php
msgid "Defines radius to combine points into one. (default: 0.0003)"
msgstr "Legt den Radius fest, innerhalb dessen Punkte zusammengefasst werden. (Standard: 0.0003)"

#: includes/setup/settings.php
msgid "Fill Color"
msgstr "Füllfarbe"

#: includes/setup/settings.php
msgid "The overlay circle fill color as FFFFFF"
msgstr "Die Füllfarbe des Overlay-Kreises als FFFFFF"

#: includes/setup/settings.php
msgid "Ring Color"
msgstr "Ringfarbe"

#: includes/setup/settings.php
msgid "Defines the outer rim color as FFFFFF"
msgstr "Legt die Farbe des äußeren Rands im Format FFFFFF fest"

#: includes/setup/settings.php
msgid "Ring Width"
msgstr "Ringbreite"

#: includes/setup/settings.php
msgid "Outer Ring width"
msgstr "Breite des äußeren Rings"

#: includes/setup/settings.php
msgid "Fill Opacity"
msgstr "Fülldeckkraft"

#: includes/setup/settings.php
msgid "Defines the fill opacity between 0 and 1"
msgstr "Legt die Deckkraft der Füllung zwischen 0 und 1 fest"

#: includes/setup/settings.php
msgid "Ring Opacity"
msgstr "Ring-Deckkraft"

#: includes/setup/settings.php
msgid "Defines the ring opacity between 0 and 1"
msgstr "Legt die Deckkraft des Rings zwischen 0 und 1 fest"

#: includes/setup/settings.php
msgid "Quality"
msgstr "Qualität"

#: includes/setup/settings.php
msgid "Number of divisions in circle (preferably > 15) greater numbers can slow down browser performance."
msgstr "Anzahl der Kreisunterteilungen (vorzugsweise > 15); größere Werte können die Browser-Leistung beeinträchtigen."
