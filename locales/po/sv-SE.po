#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "Konfigurera först kartorna under Inställningar > Kartor"

#: gpstemplates.php
msgid "Delete"
msgstr "Ta bort"

#: gpstemplates.php
msgid "Map Templates"
msgstr "Kartmallar"

#: gpstemplates.php
msgid "Host Template"
msgstr "Värdmall"

#: gpstemplates.php
msgid "Up Image"
msgstr "Bild för tillgänglig enhet"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "Bild för återhämtande enhet"

#: gpstemplates.php
msgid "Down Image"
msgstr "Bild för otillgänglig enhet"

#: gpstemplates.php
msgid "Is AP"
msgstr "Är åtkomstpunkt"

#: gpstemplates.php
msgid "True"
msgstr "Sant"

#: gpstemplates.php
msgid "False"
msgstr "Falskt"

#: gpstemplates.php
msgid "Device Template"
msgstr "Enhetsmall"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Välj den enhetsmall som ska ligga till grund för denna typ av kartmall."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Välj bilden som ska visas för en tillgänglig enhet"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Välj bilden som ska visas för en enhet som återhämtar sig"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Välj bilden som ska visas för en otillgänglig enhet"

#: gpstemplates.php
msgid "Access Point"
msgstr "Åtkomstpunkt"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Representerar den här enhetsmallen en åtkomstpunkt?"

#: gpstemplates.php
msgid "No"
msgstr "Nej"

#: gpstemplates.php
msgid "Yes"
msgstr "Ja"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "Redigera kartmall"

#: setup.php
msgid "Configure Maps"
msgstr "Konfigurera kartor"

#: setup.php
msgid "View Maps"
msgstr "Visa kartor"

#: setup.php
msgid "Map Settings"
msgstr "Kartinställningar"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Inkludera i överlägg"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Inaktivera för att endast visa värden på kartan, utan att inkludera den i täckningsöverlägget."

#: setup.php
msgid "Latitude"
msgstr "Latitud"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Enhetens latitudkoordinater"

#: setup.php
msgid "Longitude"
msgstr "Longitud"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Enhetens longitudkoordinater"

#: setup.php
msgid "Starting Degree"
msgstr "Startvinkel"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "Startvinkel för det riktade området, mellan 0 och 360 grader"

#: setup.php
msgid "Stopping Degree"
msgstr "Slutvinkel"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Slutvinkel för det riktade området. Måste vara större än startvinkeln"

#: setup.php
msgid "Specify Radius"
msgstr "Ange radie"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Ange radien för åtkomstpunkten manuellt. Ange 0 för att bestämma radien utifrån grupperade enheter"

#: setup.php
msgid "Group ID"
msgstr "Grupp-ID"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "Grupperna anger vilka enheter som ingår i täckningsöverlägget. Gruppnumret jämförs med åtkomstpunktens gruppnummer. Ange 0 för att inaktivera"
