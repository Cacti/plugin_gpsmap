#: gpsmap.php
msgid "Please make sure to properly configure Maps first under Settings > Maps"
msgstr "Se till att du först konfigurerar Maps korrekt under Inställningar > Maps"

#: gpstemplates.php
msgid "Delete"
msgstr "Ta bort"

#: gpstemplates.php
msgid "Map Templates"
msgstr "Kartmallar"

#: gpstemplates.php
msgid "Host Template"
msgstr "Värd mall"

#: gpstemplates.php
msgid "Up Image"
msgstr "Upp bild"

#: gpstemplates.php
msgid "Recovering Image"
msgstr "Återställning av bild"

#: gpstemplates.php
msgid "Down Image"
msgstr "Bild nedåt"

#: gpstemplates.php
msgid "Is AP"
msgstr "Är AP"

#: gpstemplates.php
msgid "True"
msgstr "Sant"

#: gpstemplates.php
msgid "False"
msgstr "Falskt"

#: gpstemplates.php
msgid "Device Template"
msgstr "Enhetsmall"

#: gpstemplates.php
msgid "Choose the Device Template to base this Map Template type."
msgstr "Välj den enhetsmall som ska ligga till grund för denna typ av kartmall."

#: gpstemplates.php
msgid "Select the Image to Show for an Up Device"
msgstr "Välj den bild som ska visas för en Up Device"

#: gpstemplates.php
msgid "Select the Image to Show for a Recovering Device"
msgstr "Välj den bild som ska visas för en enhet som återhämtar sig"

#: gpstemplates.php
msgid "Select the Image to Show for a Down Device"
msgstr "Välj den bild som ska visas för en nedåtriktad enhet"

#: gpstemplates.php
msgid "Access Point"
msgstr "Accesspunkt"

#: gpstemplates.php
msgid "Does this Device Template Represent an Access Point."
msgstr "Representerar denna enhetsmall en åtkomstpunkt."

#: gpstemplates.php
msgid "No"
msgstr "Nej"

#: gpstemplates.php
msgid "Yes"
msgstr "Ja"

#: gpstemplates.php
msgid "Map Template Edit"
msgstr "Kartmall Redigera"

#: setup.php
msgid "Configure Maps"
msgstr "Konfigurera kartor"

#: setup.php
msgid "View Maps"
msgstr "Visa kartor"

#: setup.php
msgid "Map Settings"
msgstr "Kartinställningar"

#: setup.php
msgid "Overlay Inclusion"
msgstr "Överlagring Inkludering"

#: setup.php
msgid "Disable to plot host only, not included in coverage overlay."
msgstr "Inaktiveras endast för plot host, ingår inte i täckningsöverlägg."

#: setup.php
msgid "Latitude"
msgstr "Latitud"

#: setup.php
msgid "The devices latitude coordinates"
msgstr "Enhetens latitudkoordinater"

#: setup.php
msgid "Longitude"
msgstr "Longitud"

#: setup.php
msgid "The devices longitude coordinates"
msgstr "Enhetens longitudkoordinater"

#: setup.php
msgid "Starting Degree"
msgstr "Startande examen"

#: setup.php
msgid "Starting degree for directional area between 0-360"
msgstr "Startgrad för riktat område mellan 0-360"

#: setup.php
msgid "Stopping Degree"
msgstr "Grad av stopp"

#: setup.php
msgid "Stopping degree for directional area, must be greater than the Starting Degree"
msgstr "Stoppgrad för riktningsområde, måste vara större än startgraden"

#: setup.php
msgid "Specify Radius"
msgstr "Ange radie"

#: setup.php
msgid "Manually specify radius for Access Point. Set to 0 to determine radius based on grouped devices"
msgstr "Ange manuellt radius för Access Point. Ställ in till 0 för att bestämma radius baserat på grupperade enheter"

#: setup.php
msgid "Group ID"
msgstr "Grupp-ID"

#: setup.php
msgid "Groups define what devices are included in the coverage overlay. Will be checked against AP device group number. 0 to disable"
msgstr "Grupper definierar vilka enheter som ingår i täckningsöverlägget. Kommer att kontrolleras mot AP-enhetens gruppnummer. 0 för att inaktivera"
